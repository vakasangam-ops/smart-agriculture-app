# ═══════════════════════════════════════════════════════════════════════
# Krishi Sahayak — Server Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ═══════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT Authentication ──────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=replace-with-a-very-long-random-secret-string-min-64-chars

# ── PostgreSQL Database (optional) ─────────────────────────────────────
# If NOT set, the platform auto-uses embedded file-backed JSON storage.
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/krishi_sahayak
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=krishi_sahayak

# ── Weather API ─────────────────────────────────────────────────────────
# Open-Meteo is free & does NOT require a key. Leave these blank unless
# you want to override with a paid commercial feed.
# WEATHER_API_KEY=

# ── Optional CORS Origins ───────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:5173
